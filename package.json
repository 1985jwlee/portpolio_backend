{
	"name": "portpolio_backend",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"modules/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome check",
		"format": "biome format --write",
		"typecheck": "tsc -b --noEmit",
		"arch": "bun scripts/arch.ts",
		"check": "bun run lint && bun run typecheck",
		"db:migrate": "bun --env-file=.env scripts/db-migrate.ts",
		"migration:immutable": "bun scripts/check-migration-immutable.ts",
		"test:integration": "bun test --path-ignore-patterns='**/node_modules/**' test/integration"
	},
	"dependencies": {
		"@pf/config": "workspace:*",
		"@pf/db": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@swc/core": "1.16.22",
		"@types/bun": "1.4.4",
		"dependency-cruiser": "18.7.2",
		"typescript": "7.0.2"
	}
}
