#!/bin/sh
# pre-commit — 스테이징된 변경에서 비밀을 찾는다(S1-15, docs/design/09-ci-cd.md §2).
# 강제가 아니라 안내다: gitleaks 가 없으면 안내만 하고 통과시키며, 최종 방어는 CI `secret-scan` 이다.
# 켜는 법: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks 가 없어 비밀 검사를 건너뛴다 (CI secret-scan 이 최종 방어다). 설치: https://github.com/gitleaks/gitleaks/releases (8.30.1)" >&2
  exit 0
fi
# exec 로 넘겨 gitleaks 의 종료 코드가 곧 훅의 종료 코드가 되게 한다 — 검출(종료 1)이면 커밋이 멈춘다.
exec gitleaks git --pre-commit --staged --redact --config .gitleaks.toml
