# 이 파일을 .env 로 복사해 값을 채운다 (cp .env.example .env).
# 비밀 항목은 비워 둔다. 저장소에 비밀을 두지 않는다.
# 키의 정본은 docs/design/01-repository-structure.md §8 이다. 키 정의는 packages/config/src/schemas/ 에 있고, 앱 전용 키는 각 앱 단계가 정의와 함께 더한다.
# DATABASE_URL_* 넷은 scripts/run-as.ts 가 프로세스마다 DATABASE_URL 로 매핑한다(dev:api·dev:worker·db:migrate — docs/design/10-security.md §5.1).
# PF_DEV_DB_PASSWORD 는 compose postgres 의 슈퍼유저·역할 비밀번호다. 아래 DATABASE_URL_* 의 비밀번호 자리(CHANGE_ME)를 같은 값으로 바꾼다.
APP_ENV=development
LOG_LEVEL=debug
PUBLIC_ORIGIN=http://localhost:8080
PF_DEV_DB_PASSWORD=CHANGE_ME
API_PORT=3001
WORKER_PORT=3003
DATABASE_URL_API=postgres://pf_api_rw:CHANGE_ME@localhost:55432/pf
DATABASE_URL_GATEWAY=postgres://pf_gateway_ro:CHANGE_ME@localhost:55432/pf
DATABASE_URL_WORKER=postgres://pf_worker_rw:CHANGE_ME@localhost:55432/pf
DATABASE_URL_MIGRATOR=postgres://pf_migrator:CHANGE_ME@localhost:55432/pf
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_SECRET=
ADMIN_GITHUB_IDS=
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=false
# 필드 암호화 키링(JSON). 각 키는 32바이트 base64 — 예: `openssl rand -base64 32`. 아래 값은 자리표시자라 그대로는 기동에 실패한다.
FIELD_KEYS={"active":"k1","keys":{"k1":"CHANGE_ME"}}
