# 호스트 재측정 번들: Bun + docker CLI + git + 저장소 코드 전체. 코드는 이미지 안에만 있고 서버 파일 시스템에 풀리지 않는다.
# 빌드: docker build -f spikes/host-remeasure/Dockerfile.bundle --build-arg BUILDKIT_CONTEXT_KEEP_GIT_DIR=1 -t pf-spike <저장소 URL>#<브랜치>
# 작성: AI 초안 (Authorship: G).
FROM docker:cli AS dockercli
FROM oven/bun:1.4.4
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates procps util-linux && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory '*'
COPY . /repo
RUN touch /repo/.built
WORKDIR /repo
